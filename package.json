		"@tiptap/extension-text-style": "^3.31.3",
		"@tiptap/extension-typography": "^3.31.3",
		"@tiptap/extension-youtube": "^3.31.3",
		"@tiptap/extensions": "^3.31.3",
		"@tiptap/markdown": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"@tiptap/suggestion": "^3.31.3",
		"bits-ui": "^2.19.3",
		"fluid-dnd": "^2.6.3",
		"katex": "^0.18.9",
		"lowlight": "^3.3.0",
		"modern-normalize": "^3.0.1",
		"playwright": "^1.63.0",
		"runed": "^0.37.1",
		"svelte-sonner": "^1.2.1",
		"svelte-tiptap": "^3.0.1",
		"tiptap-extension-auto-joiner": "^0.1.3",
		"wx-grid-data-provider": "^2.2.0",
		"wx-svelte-grid": "^2.7.0",
		"zod": "^4.6.5"
	}
}
