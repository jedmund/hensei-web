{
	"name": "hensei-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5174",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky || true; svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint --cache --concurrency auto .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:adapters": "vitest run --config vitest.config.adapter.ts",
		"test:adapters:sandbox": "VITEST_POOL=forks vitest run --config vitest.config.adapter.ts",
		"test:adapters:watch": "vitest --config vitest.config.adapter.ts",
		"test:adapters:ui": "vitest --ui --config vitest.config.adapter.ts",
		"test:adapter:types": "tsc --noEmit -p tsconfig.json",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^4.1.3",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@inlang/paraglide-js": "^2.25.4",
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.6.0",
		"@storybook/sveltekit": "^10.6.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tanstack/svelte-query-devtools": "^6.3.0",
		"@types/node": "^22",
		"@vitest/browser": "^3.2.3",
		"echarts": "^5.6.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-storybook": "^10.6.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.3.3",
		"remark-gfm": "^4.0.1",
		"sass": "^1.105.0",
		"storybook": "^10.6.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-echarts": "^1.0.0",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.71.0",
		"vite": "^7.3.1",
		"vitest": "^3.2.3",
		"vitest-browser-svelte": "^0.1.0"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,css,scss,md,html,yaml,yml}": [
			"prettier --write"
		]
	},
	"packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1142.0",
		"@aws-sdk/s3-request-presigner": "^3.1142.0",
		"@floating-ui/dom": "^1.8.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^0.562.0",
		"@sentry/sveltekit": "^10.60.0",
		"@tanstack/svelte-query": "^6.3.0",
		"@tiptap/core": "^3.31.3",
		"@tiptap/extension-bubble-menu": "^3.31.3",
		"@tiptap/extension-code-block-lowlight": "^3.31.3",
		"@tiptap/extension-floating-menu": "3.31.3",
		"@tiptap/extension-highlight": "^3.31.3",
		"@tiptap/extension-image": "^3.31.3",
		"@tiptap/extension-link": "^3.31.3",
		"@tiptap/extension-list": "^3.31.3",
