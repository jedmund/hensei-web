{
	"name": "hensei-svelte",
	"private": true,
	"license": "SEE LICENSE IN LICENSE",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5174",
		"dev:mobile": "vite dev --port 5174 --host 0.0.0.0 --strictPort",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky || true; svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"updates:sync": "node scripts/sync-updates.mjs",
		"lint": "prettier --check . && eslint --cache --concurrency auto .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:adapters": "vitest run --config vitest.config.adapter.ts",
		"test:adapters:sandbox": "VITEST_POOL=forks vitest run --config vitest.config.adapter.ts",
		"test:adapters:watch": "vitest --config vitest.config.adapter.ts",
		"test:adapters:ui": "vitest --ui --config vitest.config.adapter.ts",
		"test:adapter:types": "tsc --noEmit -p tsconfig.json",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.6.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.2",
		"@storybook/addon-a11y": "^10.6.8",
		"@storybook/addon-docs": "^10.6.8",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.6.8",
		"@storybook/sveltekit": "^10.6.8",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tanstack/svelte-query-devtools": "^6.4.7",
		"@types/node": "^22",
		"@vitest/browser": "^4.1.11",
		"@vitest/browser-playwright": "^4.1.11",
		"echarts": "^6.1.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"jsdom": "^30.1.3",
		"lint-staged": "^17.6.2",
		"postcss": "^8.5.33",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"remark-gfm": "^4.0.1",
		"sass": "^1.108.2",
		"storybook": "^10.6.8",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^1.1.0"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,css,scss,md,html,yaml,yml}": [
			"prettier --write"
		]
	},
	"packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1176.0",
		"@aws-sdk/s3-request-presigner": "^3.1176.0",
		"@floating-ui/dom": "^1.8.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.79.0",
		"@sentry/sveltekit": "^11.17.0",
		"@tanstack/svelte-query": "^6.4.7",
		"@tanstack/svelte-table": "^9.3.2",
		"@tanstack/svelte-virtual": "^3.13.54",
		"@tiptap/core": "^3.35.0",
		"@tiptap/extension-bubble-menu": "^3.35.0",
		"@tiptap/extension-code-block-lowlight": "^3.35.0",
		"@tiptap/extension-floating-menu": "3.35.0",
		"@tiptap/extension-highlight": "^3.35.0",
		"@tiptap/extension-image": "^3.35.0",
