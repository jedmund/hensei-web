			},
			{
				"kind": "length",
				"maximum": 64
			}
		],
		"name_en": [
			{
				"kind": "presence"
			}
		],
		"name_jp": [
			{
				"kind": "presence"
			}
		],
		"order": [
			{
				"kind": "numericality",
				"only_integer": true
			}
		]
	}
