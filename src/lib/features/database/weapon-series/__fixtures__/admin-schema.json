{
	"search": ["name_en", "name_jp", "slug"],
	"filters": {
		"augment_type": {
			"type": "string",
			"facet": true,
			"list": true,
			"range": false
		},
		"extra": {
			"type": "boolean",
			"facet": false,
			"list": false,
			"range": false
		},
		"element_changeable": {
			"type": "boolean",
			"facet": false,
			"list": false,
			"range": false
		},
		"has_weapon_keys": {
			"type": "boolean",
			"facet": false,
			"list": false,
			"range": false
		},
		"has_awakening": {
			"type": "boolean",
			"facet": false,
			"list": false,
			"range": false
		},
		"updated_at": {
			"type": "datetime",
			"facet": false,
			"list": false,
			"range": true
		}
	},
	"flags": [],
	"sorts": ["order", "name_en", "name_jp", "slug", "updated_at", "created_at"],
	"default_sort": ["order", "name_en"],
	"fields": [
		"id",
		"slug",
		"name_en",
		"name_jp",
		"order",
		"extra",
		"element_changeable",
		"has_weapon_keys",
		"has_awakening",
		"augment_type",
		"num_weapon_keys",
		"created_at",
		"updated_at",
		"weapon_count"
	],
	"default_fields": ["id", "slug", "name_en", "name_jp", "order"],
	"writable": {
		"name_en": "scalar",
		"name_jp": "scalar",
		"slug": "scalar",
		"order": "scalar",
		"extra": "scalar",
		"element_changeable": "scalar",
		"has_weapon_keys": "scalar",
		"has_awakening": "scalar",
		"augment_type": "scalar",
		"num_weapon_keys": "scalar"
	},
	"enums": {
		"augment_type": {
			"no_augment": 0,
			"ax": 1,
			"befoulment": 2
		}
	},
	"validators": {
		"slug": [
			{
				"kind": "presence"
			},
			{
				"kind": "uniqueness"
			},
			{
				"kind": "format",
				"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
				"flags": ""
			},
			{
				"kind": "length",
				"maximum": 64
			}
		],
		"augment_type": [
			{
				"kind": "inclusion",
				"in": ["no_augment", "ax", "befoulment"]
			}
		],
		"name_en": [
			{
				"kind": "presence"
			}
		],
		"name_jp": [
			{
				"kind": "presence"
			}
		],
		"order": [
			{
				"kind": "numericality",
				"only_integer": true
			}
		],
		"num_weapon_keys": [
			{
				"kind": "numericality",
				"only_integer": true,
				"greater_than_or_equal_to": 0,
				"allow_nil": true
			}
		]
	}
}
